<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <WarningsAsErrors />
    <NoWarn>$(NoWarn);CS1591</NoWarn> <!-- Allow missing XML comments in tests and samples if not configured -->
    <Deterministic>true</Deterministic>

    <!-- Package Metadata -->
    <Authors>DotNet.AutoNormalize Contributors</Authors>
    <Company>DotNet.AutoNormalize</Company>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SkyDevLab/DotNet.AutoNormalize</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SkyDevLab/DotNet.AutoNormalize</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <VersionPrefix>1.0.0</VersionPrefix>
    <!-- Stable 1.0.0 GA -->

    <!-- Source Link & Symbols -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- Enable XML Documentation and Packaging only for src projects -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>AutoNormalize.$(MSBuildProjectName.Replace('DotNet.AutoNormalize.', ''))</PackageId>
    <NoWarn>$(NoWarn)</NoWarn>
  </PropertyGroup>

  <!-- Non-packable projects: tests, samples, benchmarks -->
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Contains('src'))">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('src'))">
    <None Include="$(MSBuildThisFileDirectory)README.md" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)README.md')" />
    <None Include="$(MSBuildThisFileDirectory)assets\branding\icon.png" Pack="true" PackagePath="\" Visible="false" Condition="Exists('$(MSBuildThisFileDirectory)assets\branding\icon.png')" />
  </ItemGroup>
</Project>
